{
  "name": "EventLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "actor": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "ref_id": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "description"
  ]
}